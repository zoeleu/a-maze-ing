/* Colours from the A-Maze-ing TUI design */
$ground: #0E1013;
$chrome: #1B1F25;
$edge: #39404A;
$rule: #262B32;
$ink: #C7CCD1;
$muted: #8A939C;
$gold: #E8C547;
$cyan: #5BC0EB;
$red: #F25F5C;
$amber: #F2C14E;
$amber-wash: #2E2619;

Screen {
    background: $ground;
    color: $ink;
    layout: vertical;
    scrollbar-color: $edge;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $ink;
    scrollbar-background: $ground;
    scrollbar-background-hover: $ground;
    scrollbar-background-active: $ground;
    scrollbar-corner-color: $ground;
}

TitleBar {
    height: 1;
    background: $chrome;
    color: $muted;
    padding: 0 1;

    Label {
        padding: 0 1;
    }

    #brand {
        color: $gold;
        text-style: bold;
    }

    #spacer {
        width: 1fr;
    }

    #badge {
        color: $ground;
        text-style: bold;
        background: $gold;
        margin-left: 1;

        &.-cyan {
            background: $cyan;
        }

        &.-red {
            background: $red;
        }
    }
}

.banner {
    height: 1;
    padding: 0 2;
    background: $amber-wash;
    color: $amber;
}

#body {
    height: 1fr;
    padding: 1 1 0 1;
}

#maze-holder {
    width: auto;
    height: auto;
    max-height: 100%;
}

#maze-panel {
    width: auto;
    height: auto;
    max-height: 100%;
    border: solid $edge;
    padding: 0 1;
}

#side {
    width: 1fr;
    min-width: 30;
    height: auto;
    margin-left: 2;
}

/* The maze would scroll beside the side panels: put them under it, and let
   the maze grow to its full height so the whole body scrolls instead */
#body.-stacked {
    layout: vertical;
    overflow-y: auto;

    #maze-holder {
        width: 1fr;
        max-height: initial;
    }

    #maze-panel {
        max-height: initial;
        overflow-y: hidden;
    }

    #side {
        margin: 1 0 0 0;
    }
}

#too-narrow {
    display: none;
    width: 1fr;
    color: $amber;
}

#open-window {
    margin-top: 1;
}

.panel {
    height: auto;
    border: solid $edge;
    padding: 0 1;
    margin-bottom: 1;
}

.note {
    color: $muted;
}

#status {
    height: 1;
    padding: 0 2;
}

#error-body {
    height: 1fr;
}

#error-panel {
    width: auto;
    min-width: 60;
    max-width: 100;
    height: auto;
    border: solid $red;
    padding: 1 2;

    #error-title {
        color: $red;
        text-style: bold;
    }

    #error-where {
        color: $muted;
        margin-bottom: 1;
    }

    #excerpt {
        width: auto;
        background: #15181D;
        padding: 0 1;
        margin-bottom: 1;
    }

    #error-detail {
        margin-bottom: 1;
    }

    #error-hint {
        color: $muted;
    }
}

Footer {
    height: 2;
    background: $ground;
    border-top: solid $rule;
    padding: 0 1;

    FooterKey {
        background: $ground;
        color: $ink;

        .footer-key--key {
            background: $ink;
            color: $ground;
            text-style: bold;
            padding: 0 1;
        }

        .footer-key--description {
            background: $ground;
            color: $ink;
            padding: 0 2 0 1;
        }

        &:hover {
            background: $chrome;
        }
    }
}

/* The algorithm list can be clicked: show it on hover */
#algorithms:hover {
    border: solid $muted;
}

/* Shown while a maze is built */
BuildingScreen {
    align: center middle;
}

#building-panel {
    width: 50;
    height: auto;
    border: solid $edge;
    background: $chrome;
    padding: 1 2;

    #building-title {
        color: $gold;
        text-style: bold;
    }

    #building-step {
        color: $muted;
        margin-bottom: 1;
    }

    ProgressBar Bar > .bar--bar, ProgressBar Bar > .bar--indeterminate {
        color: $cyan;
    }
}

/* Asks before building a maze that may not fit in memory */
MemoryWarning {
    align: center middle;
}

#memory-panel {
    width: 70;
    height: auto;
    border: solid $amber;
    background: $chrome;
    padding: 1 2;

    #memory-title {
        color: $amber;
        text-style: bold;
        margin-bottom: 1;
    }

    #memory-detail {
        margin-bottom: 1;
    }

    #memory-buttons {
        height: auto;
        align: center middle;

        Button {
            margin: 0 1;
        }
    }
}
